%h1.text-3xl.font-bold.text-center.text-gray-800.mt-10.mb-6
  List of Tables for #{@restaurant.name}

.container.mx-auto.px-4.max-w-6xl
  .bg-white.shadow-lg.rounded-xl.p-8
    = form_with url: restaurant_tables_path(@restaurant), method: :get, local: true, class: 'mb-6' do |f|
      .flex.flex-wrap.items-center.gap-4
        .flex.items-center.gap-2
          = f.label :status, 'Filter by Status:', class: 'font-medium text-gray-700'
          = f.select :status, options_for_select(Table.statuses.keys.map { |s| [s.humanize, s] }, selected: params[:status]), include_blank: 'All', class: 'border border-gray-300 rounded-md px-3 py-2 shadow-sm focus:ring-2 focus:ring-blue-400'
        = f.submit 'Filter', class: 'bg-blue-600 text-white font-semibold px-5 py-2 rounded-md hover:bg-blue-700 transition duration-150'

    %turbo_frame_tag{:id => 'tables'}
      %table.w-full.border.border-gray-300.rounded-md.shadow-md.overflow-hidden
        %thead.bg-blue-100
          %tr
            - %w[id table_number seats status].each do |col|
              %th.px-4.py-3.text-left.text-sm.font-semibold.text-gray-700.border-b.border-gray-300
                = link_to col.titleize, restaurant_tables_path(@restaurant, sort: col, direction: toggle_direction(col), status: params[:status]), data: { turbo_frame: 'tables' }

        %tbody
          - if @tables.any?
            - @tables.each do |table|
              %tr.odd:bg-white.even:bg-gray-50.hover:bg-blue-50.transition
                %td.px-4.py-2.text-gray-800.border-b.border-gray-300= table.id
                %td.px-4.py-2.text-gray-800.border-b.border-gray-300= table.table_number
                %td.px-4.py-2.text-gray-800.border-b.border-gray-300= table.seats
                %td.px-4.py-2.border-b.border-gray-300
                  %span.inline-block.px-2.py-1.rounded-full.text-xs.font-semibold.text-white{ class: table.status == 'available' ? 'bg-green-500' : 'bg-red-500' }
                    = table.status.humanize
          - else
            %tr
              %td.px-4.py-4.text-center.text-gray-500.colspan-4
                No tables found for the selected filter.

    .mt-6.text-center
      = will_paginate @tables, renderer: WillPaginate::ActionView::LinkRenderer, class: 'pagination'
