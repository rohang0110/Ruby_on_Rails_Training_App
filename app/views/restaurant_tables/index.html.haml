%main
  .content-container
    .main-header
      %h1.header-title
        List of Tables for #{@restaurant.name}
      %p.header-subtitle
        Manage table statuses and seating for your restaurant.
    
    .content-body
      .filter-section
        = form_with url: restaurant_tables_path(@restaurant), method: :get, local: true, class: 'filter-form' do |f|
          .filter-group
            .filter-item
              = f.label :status, 'Filter by Status:', class: 'filter-label'
              .filter-input
                = f.select :status, options_for_select(Table.statuses.keys.map { |s| [s.humanize, s] }, selected: params[:status]), include_blank: 'All', class: 'select-input'
            = f.submit 'Apply Filter', class: 'filter-button'

      %turbo_frame_tag{id: 'tables'}
        .table-container
          %table.data-table
            %thead.table-head
              %tr
                - %w[Id Table\ Number Seats Status].each do |col|
                  %th.table-header= col

            %tbody.table-body
              - if @tables.any?
                - @tables.each do |table|
                  %tr.table-row{class: table.status}
                    %td.table-cell= table.id
                    %td.table-cell= table.table_number
                    %td.table-cell= table.seats
                    %td.table-cell
                      %span.status-badge
                        = table.status.humanize
              - else
                %tr
                  %td.no-data{colspan: 4}
                    No tables found for the selected filter.

      .pagination-section
        = will_paginate @tables, renderer: WillPaginate::ActionView::LinkRenderer, class: 'pagination'