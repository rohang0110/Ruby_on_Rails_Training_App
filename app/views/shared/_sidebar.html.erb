<div class="offcanvas offcanvas-start fixed-sidebar" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="sidebarMenuLabel">Menu</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <!-- Make this a flex column layout -->
  <div class="offcanvas-body d-flex flex-column justify-content-between">
    
    <!-- Top section: menu items -->
    <ul class="nav flex-column">
      <% if current_user&.staff? %>
        <!-- Staff Profile -->
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#profileMenu" role="button" aria-expanded="false" aria-controls="profileMenu">
            <i class="bi bi-person me-2"></i> My Profile
          </a>
          <div class="collapse ps-4" id="profileMenu">
            <%= link_to 'Update Avatar', edit_avatar_path, class: "nav-link" %>
            <%= link_to "Update Personal Data", edit_profile_path, class: "nav-link" %>
          </div>
        </li>
        <!-- Staff Feedbacks -->
        <li class="nav-item">
          <%= link_to feedbacks_path, class: "nav-link d-flex align-items-center" do %>
            <i class="bi bi-chat-left-text me-2"></i> Feedbacks
          <% end %>
        </li>

        <!-- Staff Restaurants -->
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#restaurantMenu" role="button" aria-expanded="false" aria-controls="restaurantMenu">
            <i class="bi bi-shop me-2"></i> Restaurants
          </a>
          <div class="collapse ps-4" id="restaurantMenu">
            <%= link_to "Restaurants", restaurants_path, class: "nav-link" %>
            <%= link_to "Create Restaurant", new_restaurant_path, class: "nav-link" %>
          </div>
        </li>

      <% elsif current_user&.customer? %>
        <!-- Customer Profile -->
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#profileMenu" role="button" aria-expanded="false" aria-controls="profileMenu">
            <i class="bi bi-person me-2"></i> Profile
          </a>
          <div class="collapse ps-4" id="profileMenu">
            <%= link_to 'Update Profile Picture', edit_avatar_path, class: "nav-link" %>
            <%= link_to "Update Personal Information", edit_profile_path, class: "nav-link" %>
          </div>
        </li>
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#restaurantMenu" role="button" aria-expanded="false" aria-controls="restaurantMenu">
            <i class="bi bi-shop me-2"></i> Restaurants
          </a>
          <div class="collapse ps-4" id="restaurantMenu">
            <%= link_to "Restaurants", restaurants_path, class: "nav-link" %>
          </div>
        </li>

        <!-- Customer Orders -->
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#ordersMenu" role="button" aria-expanded="false" aria-controls="ordersMenu">
            <i class="bi bi-bag me-2"></i> Orders
          </a>
          <div class="collapse ps-4" id="ordersMenu">
            <%= link_to "List of Orders", '#', class: "nav-link" %>
            <%= link_to "Current Orders", '#', class: "nav-link" %>
            <%= link_to "Past Orders", '#', class: "nav-link" %>
          </div>
        </li>
      <% end %>
    </ul>

    <!-- Bottom section: Sign Out -->
    <div class="mt-4">
      <%= button_to destroy_user_session_path, method: :delete, class: "nav-link text-danger d-flex align-items-center" do %>
        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
      <% end %>
    </div>
  </div>
</div>
