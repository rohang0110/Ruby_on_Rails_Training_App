<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="sidebarMenuLabel">Menu</h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body">
    <ul class="nav flex-column">
      <!-- My Profile -->
      <li class="nav-item">
        <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#profileMenu" role="button" aria-expanded="false" aria-controls="profileMenu">
          <i class="bi bi-person me-2"></i> My Profile
        </a>
        <div class="collapse ps-4" id="profileMenu">
          <%= link_to 'Update Avatar', edit_avatar_path,class: "nav-link"%>
          <%= link_to "Update personal data", "#", class: "nav-link" %>
        </div>
      </li>

      <!-- Restaurants -->
      <li class="nav-item">
        <a class="nav-link d-flex align-items-center" data-bs-toggle="collapse" href="#restaurantMenu" role="button" aria-expanded="false" aria-controls="restaurantMenu">
          <i class="bi bi-shop me-2"></i> Restaurants
        </a>
        <div class="collapse ps-4" id="restaurantMenu">
          <%= link_to "Restaurants", "#", class: "nav-link" %>
          <%= link_to "Create Restaurant", "#", class: "nav-link" %>
        </div>
      </li>

      <!-- Sign Out -->
      <li class="nav-item mt-3">
        <%= button_to destroy_user_session_path, method: :delete, class: "nav-link text-danger d-flex align-items-center" do %>
          <i class="bi bi-box-arrow-right me-2"></i> Sign Out
        <% end %>
      </li>
    </ul>
  </div>
</div>
