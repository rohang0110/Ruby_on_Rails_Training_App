%div.page-wrapper
  %div.reservation-form-container
    %h2.form-title Reserve a Table

    = simple_form_for([@restaurant, @reservation]) do |f|
      .form-group
        = f.input :reservation_date, as: :date
      .form-group
        = f.input :reservation_time, as: :time
      .form-group
        = f.input :number_of_guests
      .form-group
        = f.input :table_id,
                  collection: @restaurant.tables.available,
                  label_method: :table_number,
                  value_method: :id,
                  include_blank: 'Select a table'
      .form-group
        = f.input :customer_name, input_html: { readonly: true }
      .form-group
        = f.input :customer_contact, input_html: { readonly: true }

      .form-group
        = f.button :submit, 'Reserve', class: 'submit-btn'
