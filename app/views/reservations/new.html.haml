= simple_form_for([@restaurant, @reservation]) do |f|
  = f.input :reservation_date, as: :date
  = f.input :reservation_time, as: :time
  = f.input :number_of_guests
  = f.input :table_id, collection: @restaurant.tables.available, label_method: :table_number, value_method: :id
  = f.input :customer_name, input_html: { readonly: true }
  = f.input :customer_contact, input_html: { readonly: true }
  = f.button :submit, 'Reserve'
