%h2 Reservations for #{@restaurant.name}

%table
  %thead
    %tr
      %th Customer
      %th Contact
      %th Date
      %th Time
      %th Guests
      %th Table
      %th Status
      %th Actions

  %tbody
    - @reservations.each do |reservation|
      %tr
        %td= reservation.user.first_name
        %td= reservation.user.email
        %td= reservation.reservation_date
        %td= reservation.reservation_time.strftime("%I:%M %p")
        %td= reservation.number_of_guests
        %td= reservation.table&.table_number
        %td= reservation.status.capitalize
        %td
          - if reservation.pending?
            = button_to "Confirm", confirm_restaurant_reservation_path(@restaurant, reservation), method: :patch, data: { confirm: "Are you sure?" }
            |
            = button_to "Cancel", cancel_restaurant_reservation_path(@restaurant, reservation), method: :patch, data: { confirm: "Are you sure?" }
          - else
            %em= reservation.status.capitalize
