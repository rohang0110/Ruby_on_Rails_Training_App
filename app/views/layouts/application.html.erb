<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Demo1" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- App Icons -->
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css", media: "all", "data-turbo-track": "reload"%>

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Your custom stylesheets -->
    <%= stylesheet_link_tag "home", media: "all" %>
    <%= stylesheet_link_tag "theme", media: "all" %>
    <%= stylesheet_link_tag "restaurant_tables", media: "all" %>
    <%= stylesheet_link_tag "menu_items", media: "all" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <%= javascript_importmap_tags %>

    <style>
      /* Ensure footer sticks to bottom */
      html, body {
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      footer {
        margin-top: auto;
      }

      /* Optional: Sidebar push layout */
      .with-sidebar main {
        margin-left: 250px; /* adjust based on sidebar width */
      }
    </style>
  </head>

  <body class="<%= 'with-sidebar' if user_signed_in? %>">
    <!-- Header -->
    <header class="bg-dark text-white py-3 shadow-sm">
      <div class="container-fluid px-4 d-flex justify-content-between align-items-center">

        <!-- Left: Sidebar toggle (if signed in) and logo -->
<div class="d-flex align-items-center">
  <% if user_signed_in? %>
    <button class="btn btn-outline-light me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
      <i class="bi bi-list"></i>
    </button>
  <% end %>
  <a href="/" class="text-white text-decoration-none">
    <h2 class="mb-0 fw-bold <%= 'ms-3' if user_signed_in? %>">MyApp</h2>
  </a>
</div>


        <!-- Right: Avatar (only when signed in) -->

    <% if user_signed_in? %>
      <div class="d-flex align-items-center">
        <%= link_to edit_avatar_path, class: "rounded-circle overflow-hidden border border-white", style: "width: 42px; height: 42px;" do %>
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar.variant(resize_to_fill: [42, 42]), class: "img-fluid", alt: "Avatar" %>
          <% else %>
            <%= image_tag "default_avatar.png", class: "img-fluid", alt: "Avatar" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

      </div>
    </header>

    <!-- Sidebar (if signed in) -->
    <% if user_signed_in? %>
      <%= render 'shared/sidebar' %>
    <% end %>

    <!-- Flash Messages -->
    <div class="container mt-3">
      <% if notice %>
        <p class="alert alert-info"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert alert-danger"><%= alert %></p>
      <% end %>
    </div>

    <!-- Main Content -->
      <%= yield %>

    <!-- Footer -->
    <footer class="bg-light text-center text-muted py-3">
      &copy; <%= Time.current.year %> MyApp. All rights reserved.
    </footer>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
