
<div class="container d-flex justify-content-center">
  <div class="card p-4 shadow-lg" style="max-width: 800px; width: 100%;">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :first_name, class: "form-label" %>
          <%= f.text_field :first_name, class: "form-control", required: true %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :last_name, class: "form-label" %>
          <%= f.text_field :last_name, class: "form-control", required: true %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, class: "form-control", autocomplete: "email" %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :phone_number, class: "form-label" %>
          <%= f.telephone_field :phone_number, class: "form-control", required: true %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :age, class: "form-label" %>
          <%= f.number_field :age, class: "form-control", min: 0, required: true %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :date_of_birth, class: "form-label d-block" %>
          <div class="d-flex gap-2">
            <%= select_day nil, { default: nil }, { name: "user[date_of_birth(3i)]", class: "form-select" } %>
            <%= select_month nil, { use_month_numbers: true }, { name: "user[date_of_birth(2i)]", class: "form-select" } %>
            <%= select_year nil, { start_year: 1900, end_year: Date.today.year - 5 }, { name: "user[date_of_birth(1i)]", class: "form-select" } %>
          </div>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
        </div>

        <div class="col-md-6 mb-3">
          <%= f.label :password_confirmation, class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
        </div>
      </div>

      <div class="d-grid mt-3">
        <%= f.submit "Sign up", class: "btn btn-success btn-lg" %>
      </div>
    <% end %>

    <div class="text-center mt-3">
  <p class="text-muted">
    Already have an account?
    <%= link_to "Log in", new_user_session_path, class: "text-primary text-decoration-none" %>
  </p>
</div>

  </div>
</div>
