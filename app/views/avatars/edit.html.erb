<div class="container avatar-update-container mt-5">
  <div class="card shadow-lg border-0">
    <div class="card-body p-4">

      <h2 class="text-teal mb-4">Update Avatar</h2>

      <%= form_with model: current_user, url: avatar_path, method: :patch, local: true, html: { multipart: true } do |f| %>

        <!-- Current Avatar Preview -->
        <div class="mb-4 text-center">
          <% if current_user.avatar.attached? %>
            <p class="mb-2 text-muted">Current Avatar:</p>
            <%= image_tag current_user.avatar.variant(resize_to_limit: [150, 150]), class: "img-thumbnail rounded-circle shadow" %>
          <% else %>
            <p class="mb-2 text-muted">No avatar uploaded.</p>
            <%= image_tag "default_avatar.png", size: "150x150", class: "img-thumbnail rounded-circle shadow" %>
          <% end %>
        </div>

        <!-- Upload New Avatar -->
        <div class="mb-4">
          <%= f.label :avatar, "Upload New Avatar", class: "form-label fw-semibold" %>
          <%= f.file_field :avatar, class: "form-control" %>
        </div>

        <!-- Submit + Delete Buttons -->
        <div class="d-flex align-items-center">
          <%= f.submit "Update", class: "btn btn-teal px-4" %>

          <% if current_user.avatar.attached? %>
            <%= link_to "Delete Avatar", avatar_path, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger ms-3" %>
          <% end %>
        </div>

      <% end %>

    </div>
  </div>
</div>
