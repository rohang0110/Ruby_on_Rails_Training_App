.container.registration-container
  %h2.text-teal New Restaurant

  = form_with model: @restaurant, local: true do |f|
    - if @restaurant.errors.any?
      #errors
        %ul
          - @restaurant.errors.full_messages.each do |msg|
            %li= msg

    .field
      = f.label :name
      = f.text_field :name

    .field
      = f.label :description
      = f.text_area :description

    .field
      = f.label :location
      = f.text_field :location

    .field
      = f.label :cuisine_type
      = f.text_field :cuisine_type


    .actions
      = f.submit 'Create Restaurant', class: "btn-teal"
